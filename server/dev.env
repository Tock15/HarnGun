# Local development values for docker-compose.dev.yml. Dummy credentials only; never put real keys here.
DATABASE_ENDPOINT=http://localhost:8000
TABLE_NAME=HarnGun_Main
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=harngun-receipts
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=harngun-dev
S3_SECRET_ACCESS_KEY=harngun-dev-secret
AUTH=dev
DEV_AUTH_SECRET=dev-only-not-a-secret
MOCK_AI=true
BEDROCK_REGION=ap-southeast-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
