{
  "name": "@harngun/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=dev.env express/server.ts",
    "start": "tsx express/server.ts",
    "build": "esbuild express/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.mjs \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@harngun/shared": "*",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
